# 默认：提交时转为 LF，检出时按平台自动
* text=auto

# 源码统一用 LF
*.java    text eol=lf
*.gradle  text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.mcmeta  text eol=lf
*.properties text eol=lf

# 保持原样，不做换行转换
*.jar     binary
*.png     binary
*.jpg     binary
*.ico     binary

# Git 语言识别
*.java    linguist-language=Java
LICENSE   linguist-documentation=false
